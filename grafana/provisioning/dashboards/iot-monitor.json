        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "athena-iot-monitor"
                      },
                      "group": "grafana-athena-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "connectionArgs": {
                          "catalog": "__default",
                          "database": "__default",
                          "region": "__default",
                          "resultReuseEnabled": true,
                          "resultReuseMaxAgeInMinutes": 60
                        },
                        "format": 0,
                        "rawSQL": "SELECT\n  $__parseTime(ts, 'yyyy-MM-dd''T''HH:mm:ss''Z') AS time,\n  -- device_id || ' A' AS metric,\n  (ah - LAG(ah, 1) OVER (PARTITION BY device_id ORDER BY ts))\n  /\n  (date_diff('second',\n    from_iso8601_timestamp(LAG(ts, 1) OVER (PARTITION BY device_id ORDER BY ts)),\n    from_iso8601_timestamp(ts)\n  ) / 3600.0) as A,\n  (ah - LAG(ah, 1) OVER (PARTITION BY device_id ORDER BY ts)) * sub\n  /\n  (date_diff('second',\n    from_iso8601_timestamp(LAG(ts, 1) OVER (PARTITION BY device_id ORDER BY ts)),\n    from_iso8601_timestamp(ts)\n  ) / 3600.0) as W\nFROM sensor_data\nWHERE type = 'battery'\n  AND (\n    CONCAT(year, month, day, hour) BETWEEN date_format($__timeFrom(), '%Y%m%d%H') AND date_format($__timeTo(), '%Y%m%d%H')\n  )\n  AND $__parseTime(ts, 'yyyy-MM-dd''T''HH:mm:ss''Z') BETWEEN $__timeFrom() AND $__timeTo()\n  AND device_id IN(${target_devices:singlequote})\nORDER BY time ASC\n"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
