          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "athena-iot-monitor"
          },
          "format": 0,
          "rawSQL": "SELECT\n  $__parseTime(ts, 'yyyy-MM-dd''T''HH:mm:ss''Z') AS time,\n  -- device_id || ' Ah' AS metric,\n  MAX(ah) OVER (\n    ORDER BY CAST($__parseTime(ts, 'yyyy-MM-dd''T''HH:mm:ss''Z') AS DATE)\n    RANGE BETWEEN INTERVAL '1' DAY PRECEDING AND CURRENT ROW\n  ) as rolling_max_value,\n  ah AS Ah,\n  ah / 200.0 * 100.0 AS percent\nFROM sensor_data\nWHERE type = 'battery'\n  AND (\n    (year = '${__from:date:YYYY}' AND month = '${__from:date:MM}' AND day >= '${__from:date:DD}')\n    OR\n    (year = '${__to:date:YYYY}'   AND month = '${__to:date:MM}'   AND day <= '${__to:date:DD}')\n  )\n  AND $__parseTime(ts, 'yyyy-MM-dd''T''HH:mm:ss''Z') BETWEEN $__timeFrom() AND $__timeTo()\n  AND device_id IN(${target_devices:singlequote})\nORDER BY time ASC",
          "refId": "A"
        }
      ],
      "title": "充電量",
      "type": "timeseries"
