          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "athena-iot-monitor"
          },
          "format": 1,
          "rawSQL": "SELECT\r\n  $__parseTime(ts, 'yyyy-MM-dd''T''HH:mm:ss''Z') AS time,\r\n  'sub-main(V)' AS metric,\r\n  sub - main AS V\r\nFROM sensor_data\r\nWHERE type = 'battery'\r\n  AND (\r\n    (year = '${__from:date:YYYY}' AND month = '${__from:date:MM}')\r\n    OR\r\n    (year = '${__to:date:YYYY}'   AND month = '${__to:date:MM}')\r\n  )\r\n  AND $__parseTime(ts, 'yyyy-MM-dd''T''HH:mm:ss''Z') BETWEEN $__timeFrom() AND $__timeTo()\r\n  AND device_id IN(${target_devices:singlequote})\r\nORDER BY time ASC\r\n",
          "refId": "B"
        }
