                        "format": 0,
                        "rawSQL": "SELECT\n  $__parseTime(ts, 'yyyy-MM-dd''T''HH:mm:ss''Z') AS time,\n  -- device_id || ' Ah' AS metric,\n  MAX(ah) OVER (\n    ORDER BY CAST($__parseTime(ts, 'yyyy-MM-dd''T''HH:mm:ss''Z') AS DATE)\n    RANGE BETWEEN INTERVAL '1' DAY PRECEDING AND CURRENT ROW\n  ) as rolling_max,\n  ah AS Ah,\n  ah / 200.0 * 100.0 AS percent,\n  ROUND(ah / ${divisor_amp} * 12) * 5 * 60 AS remaining\nFROM sensor_data\nWHERE type = 'battery'\n  AND (\n    CONCAT(year, month, day, hour) BETWEEN date_format($__timeFrom(), '%Y%m%d%H') AND date_format($__timeTo(), '%Y%m%d%H')\n  )\n  AND $__parseTime(ts, 'yyyy-MM-dd''T''HH:mm:ss''Z') BETWEEN $__timeFrom() AND $__timeTo()\n  AND device_id IN(${target_devices:singlequote})\nORDER BY time ASC"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
