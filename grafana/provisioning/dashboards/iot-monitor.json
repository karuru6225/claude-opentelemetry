                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "athena-iot-monitor"
                      },
                      "group": "grafana-athena-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "connectionArgs": {
                          "catalog": "__default",
                          "database": "__default",
                          "region": "__default",
                          "resultReuseEnabled": false,
                          "resultReuseMaxAgeInMinutes": 60
                        },
                        "format": 1,
                        "rawSQL": "SELECT\r\n  $__parseTime(ts, 'yyyy-MM-dd''T''HH:mm:ss''Z') AS time,\r\n  temp\r\nFROM sensor_data\r\nWHERE type = 'battery'\r\n  AND (\r\n    CONCAT(year, month, day, hour) BETWEEN date_format($__timeFrom(), '%Y%m%d%H') AND date_format($__timeTo(), '%Y%m%d%H')\r\n  )\r\n  AND $__parseTime(ts, 'yyyy-MM-dd''T''HH:mm:ss''Z') BETWEEN $__timeFrom() AND $__timeTo()\r\n  AND device_id IN(${target_devices:singlequote})\r\nORDER BY time ASC"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
